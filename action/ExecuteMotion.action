# =========================================
# GOAL
# =========================================

# Target position and heading
MotionTarget target

# Motion primitive type and parameters
MotionPrimitive primitive

# Desired motion references
MotionReference reference

# Position-loop controller
ControllerConfig pos_controller

# Velocity-loop controller
ControllerConfig vel_controller

---
# =========================================
# RESULT
# =========================================

# Execution result states
uint8 SUCCEEDED=0
uint8 CANCELED=1
uint8 ABORTED=2

uint8 state

# Total execution time (seconds)
float64 exec_t

# Error codes
uint16 ERR_NONE=0
uint16 ERR_INVALID_GOAL=1
uint16 ERR_UNSUPPORTED_PRIMITIVE=2
uint16 ERR_UNSUPPORTED_CONTROLLER=3
uint16 ERR_STATE_UNAVAILABLE=4
uint16 ERR_STATE_TIMEOUT=5
uint16 ERR_EXECUTION_TIMEOUT=6
uint16 ERR_INTERNAL=255

uint16 err_code

# Human-readable result description
string message

---
# =========================================
# FEEDBACK
# =========================================

# Projected progress along initial A-B
# Range: [0.0, 1.0]
float32 progress

# Current target tracking error (meter)
float64 tracking_error

# Remaining Euclidean distance (meter)
float64 remain_dis

# Elapsed execution time (seconds)
float64 elapsed_t
